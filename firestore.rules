rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isApplicationOwner() {
      return signedIn() && request.auth.token.uygulamaSahibi == true;
    }

    function isRetentionCleanupWindow(periodYear) {
      let istanbulNow = request.time + duration.value(3, 'h');
      return istanbulNow.year() >= 2029
        && istanbulNow.month() == 7
        && periodYear == istanbulNow.year() - 3;
    }

    function profilePath(userId) {
      return /databases/$(database)/documents/kullanicilar/$(userId);
    }

    // Öğretmen yetkisi yalnızca açıkça tanımlanmış rol üzerinden verilir.
    // Rolü olmayan hesaplar migration tamamlanana kadar erişim alamaz.
    function isTeacher() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.rol == 'ogretmen';
    }

    function isStudent() {
      return signedIn()
        && exists(profilePath(request.auth.uid))
        && get(profilePath(request.auth.uid)).data.rol == 'ogrenci';
    }

    function studentLinkPath(teacherUid, classId) {
      return /databases/$(database)/documents/ogretmenOgrenciBaglantilari/$(teacherUid + '__' + request.auth.uid + '__' + classId);
    }

    function linkedStudentRecordExists(teacherUid, classId) {
      let link = get(studentLinkPath(teacherUid, classId)).data;
      let studentPath = /databases/$(database)/documents/ogrenciler/$(link.ogrenciKayitId);
      let classPath = /databases/$(database)/documents/siniflar/$(classId);
      return exists(studentPath)
        && get(studentPath).data.uid == teacherUid
        && (get(studentPath).data.sinifId == classId
          || get(studentPath).data.get('sinifGecmisiIds', []).hasAny([classId]))
        && get(studentPath).data.donemYili == link.donemYili
        && exists(classPath)
        && get(classPath).data.uid == teacherUid
        && get(classPath).data.donemYili == link.donemYili;
    }

    function studentHasPermission(teacherUid, classId, permission) {
      return isStudent()
        && exists(studentLinkPath(teacherUid, classId))
        && get(studentLinkPath(teacherUid, classId)).data.durum == 'active'
        && linkedStudentRecordExists(teacherUid, classId)
        && get(studentLinkPath(teacherUid, classId)).data.izinler.get(permission, false) == true;
    }

    function linkedStudentRecordId(teacherUid, classId) {
      return get(studentLinkPath(teacherUid, classId)).data.ogrenciKayitId;
    }

    function ownsRecord() {
      return isTeacher()
        && resource.data.uid == request.auth.uid;
    }

    function createsOwnRecord() {
      return isTeacher()
        && request.resource.data.uid == request.auth.uid;
    }

    // request.time UTC'dir; +3 saat Europe/Istanbul yerel saatini verir.
    // Haziran ayında biten eski dönem ve başlayan yeni dönem birlikte yazılabilir.
    function isEditablePeriod(period) {
      let localNow = request.time + duration.value(3, 'h');
      let currentYear = localNow.year();
      let currentMonth = localNow.month();
      return period is int
        && (
          (period == currentYear && currentMonth >= 6)
          || (period == currentYear - 1 && currentMonth <= 6)
        );
    }

    function createsOwnPeriodRecord() {
      return createsOwnRecord()
        && request.resource.data.keys().hasAny(['donemYili'])
        && isEditablePeriod(request.resource.data.donemYili);
    }

    function ownsEditablePeriodRecord() {
      return ownsRecord()
        && resource.data.keys().hasAny(['donemYili'])
        && isEditablePeriod(resource.data.donemYili);
    }

    function keepsPeriod() {
      return request.resource.data.donemYili == resource.data.donemYili;
    }

    function keepsOwner() {
      return request.resource.data.uid == resource.data.uid
        && resource.data.uid == request.auth.uid;
    }

    function ownsDocument(collectionName, documentId) {
      return documentId is string
        && exists(/databases/$(database)/documents/$(collectionName)/$(documentId))
        && get(/databases/$(database)/documents/$(collectionName)/$(documentId)).data.uid == request.auth.uid;
    }

    // Batch içinde aynı anda oluşturulan kitap + konu kayıtlarını
    // doğrulayabilmek için getAfter / existsAfter kullanılır.
    function ownsDocumentAfter(collectionName, documentId) {
      return documentId is string
        && existsAfter(/databases/$(database)/documents/$(collectionName)/$(documentId))
        && getAfter(/databases/$(database)/documents/$(collectionName)/$(documentId)).data.uid == request.auth.uid;
    }

    function schoolAcceptsNewRecords(schoolId) {
      return schoolId == ''
        || (schoolId is string
          && ownsDocument('okullar', schoolId)
          && get(/databases/$(database)/documents/okullar/$(schoolId)).data.get('arsivlendi', false) != true
          && get(/databases/$(database)/documents/okullar/$(schoolId)).data.get('arsivDurumu', '') != 'isleniyor');
    }

    function classBelongsToTeacher(data) {
      let classPath = /databases/$(database)/documents/siniflar/$(data.sinifId);
      let classData = get(classPath).data;
      return data.sinifId is string
        && ownsDocument('siniflar', data.sinifId)
        && classData.donemYili == data.donemYili
        && classData.get('arsivlendi', false) != true
        && classData.get('arsivDurumu', '') != 'isleniyor'
        && schoolAcceptsNewRecords(classData.get('okulId', ''));
    }

    function studentBelongsToClass(data) {
      return data.ogrenciId is string
        && data.sinifId is string
        && ownsDocument('ogrenciler', data.ogrenciId)
        && get(/databases/$(database)/documents/ogrenciler/$(data.ogrenciId)).data.sinifId == data.sinifId
        && get(/databases/$(database)/documents/ogrenciler/$(data.ogrenciId)).data.donemYili == data.donemYili
        && classBelongsToTeacher(data);
    }

    // Sınıf taşıma sırasında kitap/konu kayıtları, öğrenci kaydındaki açık
    // ve öğretmen tarafından başlatılmış hedef sınıfa geçici olarak taşınabilir.
    function studentBelongsToClassOrPendingTransfer(data) {
      let studentPath = /databases/$(database)/documents/ogrenciler/$(data.ogrenciId);
      return data.ogrenciId is string
        && data.sinifId is string
        && exists(studentPath)
        && get(studentPath).data.uid == request.auth.uid
        && get(studentPath).data.donemYili == data.donemYili
        && (
          get(studentPath).data.sinifId == data.sinifId
          || (
            get(studentPath).data.get('sinifTasiIslemi', null) is map
            && get(studentPath).data.sinifTasiIslemi.kaynakSinifId == get(studentPath).data.sinifId
            && get(studentPath).data.sinifTasiIslemi.hedefSinifId == data.sinifId
            && get(studentPath).data.sinifTasiIslemi.donemYili == data.donemYili
            && ownsDocument('siniflar', get(studentPath).data.sinifId)
            && get(/databases/$(database)/documents/siniflar/$(get(studentPath).data.sinifId)).data.donemYili == data.donemYili
          )
        )
        && classBelongsToTeacher(data);
    }

    function schoolBelongsToTeacher(data) {
      return !data.keys().hasAny(['okulId'])
        || data.okulId == ''
        || (data.okulId is string
          && ownsDocument('okullar', data.okulId)
          && get(/databases/$(database)/documents/okullar/$(data.okulId)).data.donemYili == data.donemYili);
    }

    function optionalLessonBelongsToTeacher(data) {
      return !data.keys().hasAny(['dersId'])
        || data.dersId == null
        || data.dersId == ''
        // Silinen gelecek ders programları geçmiş ödev/not kayıtlarını bozmaz.
        || !exists(/databases/$(database)/documents/dersler/$(data.dersId))
        || (
          ownsDocument('dersler', data.dersId)
          && get(/databases/$(database)/documents/dersler/$(data.dersId)).data.sinifId == data.sinifId
          && get(/databases/$(database)/documents/dersler/$(data.dersId)).data.donemYili == data.donemYili
        );
    }

    function validLibraryBook(data) {
      return data.keys().hasOnly(['ad', 'sayfaSayisi', 'uid', 'olusturulma'])
        && data.keys().hasAll(['ad', 'sayfaSayisi', 'uid', 'olusturulma'])
        && data.uid == request.auth.uid
        && data.ad is string
        && data.ad.size() >= 1
        && data.ad.size() <= 160
        && data.sayfaSayisi is int
        && data.sayfaSayisi > 0
        && data.olusturulma is string;
    }

    function validLibraryTopic(data) {
      let bookPath = /databases/$(database)/documents/kitapKutuphanesi/$(data.kitapId);
      return data.keys().hasOnly(['ad', 'baslangicSayfa', 'bitisSayfa', 'kazanımKodu', 'kaynak', 'kitapId', 'kitapAd', 'uid', 'olusturulma'])
        && data.keys().hasAll(['ad', 'baslangicSayfa', 'bitisSayfa', 'kazanımKodu', 'kaynak', 'kitapId', 'kitapAd', 'uid', 'olusturulma'])
        && data.uid == request.auth.uid
        && data.ad is string
        && data.ad.size() >= 1
        && data.ad.size() <= 200
        && data.baslangicSayfa is int
        && data.baslangicSayfa > 0
        && data.bitisSayfa is int
        && data.bitisSayfa >= data.baslangicSayfa
        && data.get('kazanımKodu', '') is string
        && data.kaynak in ['manuel', 'kazanım']
        && data.kitapId is string
        && exists(bookPath)
        && get(bookPath).data.uid == request.auth.uid
        && data.kitapAd is string
        && data.kitapAd.size() >= 1
        && data.olusturulma is string
        && data.bitisSayfa <= get(bookPath).data.sayfaSayisi;
    }

    function individualEventBelongsToTeacher(data) {
      return data.bireyselEtkinlikId is string
        && ownsDocument('bireyselEtkinlikler', data.bireyselEtkinlikId)
        && get(/databases/$(database)/documents/bireyselEtkinlikler/$(data.bireyselEtkinlikId)).data.ogrenciId == data.ogrenciId
        && get(/databases/$(database)/documents/bireyselEtkinlikler/$(data.bireyselEtkinlikId)).data.sinifId == data.sinifId;
    }

    function assignedBookBelongsToStudent(data) {
      return data.kitapId is string
        && ownsDocumentAfter('kitaplar', data.kitapId)
        && getAfter(/databases/$(database)/documents/kitaplar/$(data.kitapId)).data.ogrenciId == data.ogrenciId
        && getAfter(/databases/$(database)/documents/kitaplar/$(data.kitapId)).data.sinifId == data.sinifId
        && getAfter(/databases/$(database)/documents/kitaplar/$(data.kitapId)).data.donemYili == data.donemYili;
    }

    // Kullanıcı profili: herkes yalnızca kendi profil belgesini görebilir.
    function pairingCodePath(codeId) {
      return /databases/$(database)/documents/ogrenciEslesmeKodlari/$(codeId);
    }

    function pairingRequestPath(requestId) {
      return /databases/$(database)/documents/ogrenciEslesmeTalepleri/$(requestId);
    }

    function studentLinkDocPath(linkId) {
      return /databases/$(database)/documents/ogretmenOgrenciBaglantilari/$(linkId);
    }

    function studentRecordIndexPath(indexId) {
      return /databases/$(database)/documents/ogrenciKayitEslesmeleri/$(indexId);
    }

    function validStudentPermissions(permissions) {
      return permissions is map
        && permissions.keys().hasOnly(['dersProgrami', 'dersNotlari', 'konular', 'yoklama', 'odevler', 'kitaplar'])
        && permissions.keys().hasAll(['dersProgrami', 'dersNotlari', 'konular', 'yoklama', 'odevler', 'kitaplar'])
        && permissions.dersProgrami is bool
        && permissions.dersNotlari is bool
        && permissions.konular is bool
        && permissions.yoklama is bool
        && permissions.odevler is bool
        && permissions.kitaplar is bool;
    }

    function validPairingInvite(codeId, requestData) {
      let codePath = pairingCodePath(codeId);
      let invite = get(codePath).data;
      let studentPath = /databases/$(database)/documents/ogrenciler/$(requestData.ogrenciKayitId);
      let classPath = /databases/$(database)/documents/siniflar/$(requestData.sinifId);
      return exists(codePath)
        && invite.kullanildi == false
        && invite.sonaErme > request.time
        && invite.ogretmenUid == requestData.ogretmenUid
        && invite.ogrenciKayitId == requestData.ogrenciKayitId
        && invite.sinifId == requestData.sinifId
        && invite.donemYili == requestData.donemYili
        && exists(studentPath)
        && get(studentPath).data.uid == invite.ogretmenUid
        && get(studentPath).data.sinifId == invite.sinifId
        && get(studentPath).data.donemYili == invite.donemYili
        && get(studentPath).data.get('adSoyad', get(studentPath).data.get('ad', '') + ' ' + get(studentPath).data.get('soyad', '')) == requestData.ogrenciHesapAdi
        && get(studentPath).data.get('epostaEslesme', get(studentPath).data.get('eposta', '')) == request.auth.token.email
        && exists(classPath)
        && get(classPath).data.uid == invite.ogretmenUid
        && get(classPath).data.donemYili == invite.donemYili;
    }

    function validStudentPairingRequest(data) {
      let profileAfter = getAfter(profilePath(request.auth.uid)).data;
      return signedIn()
        && request.auth.token.email_verified == true
        && data.ogrenciUid == request.auth.uid
        && data.uid == data.ogretmenUid
        && isEditablePeriod(data.donemYili)
        && data.ogrenciEposta == request.auth.token.email
        && data.durum == 'bekliyor'
        && data.kodId is string
        && validPairingInvite(data.kodId, data)
        && profileAfter.rol == 'ogrenci'
        && profileAfter.eposta == request.auth.token.email
        && profileAfter.kullaniciAdi == data.ogrenciHesapAdi;
    }

    function createsOwnUserProfile(userId) {
      let data = request.resource.data;
      return signedIn()
        && request.auth.uid == userId
        && request.auth.token.email is string
        && data.eposta == request.auth.token.email
        && data.kullaniciAdi is string
        && data.kullaniciAdi.size() >= 2
        && data.kullaniciAdi.size() <= 80
        && data.keys().hasOnly(['kullaniciAdi', 'brans', 'sezon', 'rol', 'eposta', 'olusturulmaTarihi', 'ilkEslesmeTalepId'])
        && (
          (data.rol == 'ogretmen'
            && data.brans is string
            && data.brans.size() > 0
            && data.brans.size() <= 50
            && data.sezon is string
            && data.sezon.matches('^[0-9]{4}/[0-9]{4}$'))
          ||
          (data.rol == 'ogrenci'
            && !data.keys().hasAny(['brans', 'sezon'])
            && request.auth.token.email_verified == true
            && data.ilkEslesmeTalepId is string
            && existsAfter(pairingRequestPath(data.ilkEslesmeTalepId))
            && getAfter(pairingRequestPath(data.ilkEslesmeTalepId)).data.ogrenciUid == userId
            && getAfter(pairingRequestPath(data.ilkEslesmeTalepId)).data.durum == 'bekliyor'
            && getAfter(pairingRequestPath(data.ilkEslesmeTalepId)).data.ogrenciEposta == request.auth.token.email
            && getAfter(pairingRequestPath(data.ilkEslesmeTalepId)).data.ogrenciHesapAdi == data.kullaniciAdi)
        );
    }

    function updatesOwnUserProfile(userId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      return signedIn()
        && request.auth.uid == userId
        && resource.data.keys().hasAny(['rol'])
        && data.rol == resource.data.rol
        && data.eposta == resource.data.eposta
        && changed.hasOnly(['kullaniciAdi', 'brans', 'sezon'])
        && (!changed.hasAny(['kullaniciAdi'])
          || (data.kullaniciAdi is string
            && data.kullaniciAdi.size() >= 2
            && data.kullaniciAdi.size() <= 80))
        && (!changed.hasAny(['brans'])
          || (resource.data.rol == 'ogretmen'
            && data.brans is string
            && data.brans.size() > 0
            && data.brans.size() <= 50))
        && (!changed.hasAny(['sezon'])
          || (resource.data.rol == 'ogretmen'
            && data.sezon is string
            && data.sezon.matches('^[0-9]{4}/[0-9]{4}$')));
    }

    function createsPairingCode(codeId) {
      let data = request.resource.data;
      let studentPath = /databases/$(database)/documents/ogrenciler/$(data.ogrenciKayitId);
      let classPath = /databases/$(database)/documents/siniflar/$(data.sinifId);
      return isTeacher()
        && codeId.matches('^[A-Fa-f0-9]{64}$')
        && data.keys().hasOnly(['uid', 'ogretmenUid', 'ogrenciKayitId', 'sinifId', 'donemYili', 'kullanildi', 'olusturulma', 'sonaErme'])
        && data.uid == request.auth.uid
        && data.ogretmenUid == request.auth.uid
        && data.ogrenciKayitId is string
        && data.sinifId is string
        && data.donemYili is int
        && data.kullanildi == false
        && data.olusturulma == request.time
        && data.sonaErme > request.time
        && data.sonaErme <= request.time + duration.value(12, 'h')
        && isEditablePeriod(data.donemYili)
        && exists(studentPath)
        && get(studentPath).data.uid == request.auth.uid
        && get(studentPath).data.sinifId == data.sinifId
        && get(studentPath).data.donemYili == data.donemYili
        && exists(classPath)
        && get(classPath).data.uid == request.auth.uid
        && get(classPath).data.donemYili == data.donemYili
        && get(classPath).data.kademe in ['9', '10', '11', '12', 'TYT', 'AYT', 9, 10, 11, 12];
    }

    function consumesPairingCode(codeId) {
      let requestId = request.resource.data.talepId;
      return signedIn()
        && request.auth.uid != resource.data.ogretmenUid
        && request.auth.token.email_verified == true
        && resource.data.kullanildi == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kullanildi', 'kullanilma', 'talepId'])
        && request.resource.data.kullanildi == true
        && request.resource.data.talepId is string
        && existsAfter(pairingRequestPath(requestId))
        && getAfter(pairingRequestPath(requestId)).data.kodId == codeId
        && getAfter(pairingRequestPath(requestId)).data.ogrenciUid == request.auth.uid
        && getAfter(pairingRequestPath(requestId)).data.durum == 'bekliyor';
    }

    function updatesPairingRequest(requestId) {
      // Reddedilen taleplerde baglantiId alanı bulunmaz; get() eksik alanı güvenli karşılar.
      let linkId = request.resource.data.get('baglantiId', '');
      return isTeacher()
        && resource.data.ogretmenUid == request.auth.uid
        && resource.data.durum == 'bekliyor'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum', 'baglantiId', 'yanitTarihi'])
        && request.resource.data.yanitTarihi == request.time
        && (
          (request.resource.data.durum == 'reddedildi' && linkId == '')
          ||
          (request.resource.data.durum == 'onaylandi'
            && linkId == request.auth.uid + '__' + resource.data.ogrenciUid + '__' + resource.data.sinifId
            && existsAfter(studentLinkDocPath(linkId))
            && getAfter(studentLinkDocPath(linkId)).data.talepId == requestId
            && getAfter(studentLinkDocPath(linkId)).data.ogrenciUid == resource.data.ogrenciUid
            && getAfter(studentLinkDocPath(linkId)).data.ogrenciKayitId == resource.data.ogrenciKayitId
            && getAfter(studentLinkDocPath(linkId)).data.durum == 'active')
        );
    }

    function createsApprovedStudentLink(linkId) {
      let data = request.resource.data;
      let requestPath = pairingRequestPath(data.talepId);
      let requestData = getAfter(requestPath).data;
      let studentPath = /databases/$(database)/documents/ogrenciler/$(data.ogrenciKayitId);
      let classPath = /databases/$(database)/documents/siniflar/$(data.sinifId);
      let indexPath = studentRecordIndexPath(request.auth.uid + '__' + data.ogrenciKayitId);
      return isTeacher()
        && linkId == request.auth.uid + '__' + data.ogrenciUid + '__' + data.sinifId
        && existsAfter(requestPath)
        && requestData.durum == 'onaylandi'
        && requestData.yanitTarihi == request.time
        && requestData.baglantiId == linkId
        && requestData.ogretmenUid == request.auth.uid
        && requestData.ogrenciUid == data.ogrenciUid
        && requestData.ogrenciKayitId == data.ogrenciKayitId
        && requestData.sinifId == data.sinifId
        && data.talepId is string
        && data.uid == request.auth.uid
        && data.ogretmenUid == request.auth.uid
        && data.ogrenciUid is string
        && data.durum == 'active'
        && validStudentPermissions(data.izinler)
        && isEditablePeriod(data.donemYili)
        && exists(studentPath)
        && get(studentPath).data.uid == request.auth.uid
        && get(studentPath).data.sinifId == data.sinifId
        && get(studentPath).data.donemYili == data.donemYili
        && exists(classPath)
        && get(classPath).data.uid == request.auth.uid
        && get(classPath).data.donemYili == data.donemYili
        && exists(profilePath(data.ogrenciUid))
        && get(profilePath(data.ogrenciUid)).data.rol == 'ogrenci'
        && (!exists(indexPath)
          || get(indexPath).data.durum != 'active'
          || get(indexPath).data.ogrenciUid == data.ogrenciUid);
    }

    // Yalnızca daha önce iptal edilmiş aynı bağlantı, yeni bir onaylı taleple
    // yeniden etkinleştirilebilir. Öğrenci/sınıf/dönem kimliği değiştirilemez.
    function reactivatesStudentLink(linkId) {
      return isTeacher()
        && resource.data.ogretmenUid == request.auth.uid
        && resource.data.durum == 'revoked'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'talepId', 'ogretmenHesapAdi', 'ogrenciAd', 'sinifAd', 'okulAd',
          'kademe', 'ders', 'ogrenciHesapAdi', 'ogrenciEposta', 'izinler',
          'durum', 'olusturulma', 'iptalTarihi'
        ])
        && request.resource.data.ogrenciUid == resource.data.ogrenciUid
        && request.resource.data.ogrenciKayitId == resource.data.ogrenciKayitId
        && request.resource.data.sinifId == resource.data.sinifId
        && request.resource.data.donemYili == resource.data.donemYili
        && request.resource.data.durum == 'active'
        && request.resource.data.iptalTarihi == null
        && request.resource.data.olusturulma == request.time
        && createsApprovedStudentLink(linkId);
    }

    function createsApprovedStudentIndex(indexId) {
      let data = request.resource.data;
      let linkPath = studentLinkDocPath(data.baglantiId);
      return isTeacher()
        && indexId == request.auth.uid + '__' + data.ogrenciKayitId
        && existsAfter(linkPath)
        && getAfter(linkPath).data.ogretmenUid == request.auth.uid
        && getAfter(linkPath).data.ogrenciKayitId == data.ogrenciKayitId
        && getAfter(linkPath).data.ogrenciUid == data.ogrenciUid
        && getAfter(linkPath).data.durum == 'active'
        && data.uid == request.auth.uid
        && data.ogretmenUid == request.auth.uid
        && data.durum == 'active';
    }

    // İptal edilmiş öğrenci kaydı bağlantı indeksi, yeni ve onaylı bir
    // eşleştirme sonrasında aynı öğrenci kaydına yeniden bağlanabilir.
    function reactivatesStudentIndex(indexId) {
      let data = request.resource.data;
      let linkPath = studentLinkDocPath(data.baglantiId);
      let link = getAfter(linkPath).data;
      let requestPath = pairingRequestPath(link.talepId);
      let pairingRequest = getAfter(requestPath).data;
      return isTeacher()
        && resource.data.ogretmenUid == request.auth.uid
        && resource.data.uid == request.auth.uid
        && resource.data.durum == 'revoked'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ogrenciUid', 'sinifId', 'donemYili', 'baglantiId', 'durum', 'iptalTarihi', 'guncellenme'
        ])
        && indexId == request.auth.uid + '__' + data.ogrenciKayitId
        && data.uid == request.auth.uid
        && data.ogretmenUid == request.auth.uid
        && data.ogrenciUid is string
        && data.ogrenciKayitId == resource.data.ogrenciKayitId
        && data.durum == 'active'
        && data.guncellenme == request.time
        && data.get('iptalTarihi', null) == null
        && data.baglantiId == request.auth.uid + '__' + data.ogrenciUid + '__' + data.sinifId
        && existsAfter(linkPath)
        && link.ogretmenUid == request.auth.uid
        && link.ogrenciUid == data.ogrenciUid
        && link.ogrenciKayitId == data.ogrenciKayitId
        && link.sinifId == data.sinifId
        && link.donemYili == data.donemYili
        && link.durum == 'active'
        && existsAfter(requestPath)
        && pairingRequest.durum == 'onaylandi'
        && pairingRequest.yanitTarihi == request.time
        && pairingRequest.baglantiId == data.baglantiId
        && pairingRequest.ogretmenUid == request.auth.uid
        && pairingRequest.ogrenciUid == data.ogrenciUid
        && pairingRequest.ogrenciKayitId == data.ogrenciKayitId
        && pairingRequest.sinifId == data.sinifId;
    }

    function studentCanCreateHomeworkCompletion(data, notificationId) {
      let linkPath = studentLinkDocPath(data.baglantiId);
      let link = get(linkPath).data;
      let homeworkPath = /databases/$(database)/documents/odevler/$(data.odevId);
      let homework = get(homeworkPath).data;
      return isStudent()
        && notificationId == request.auth.uid + '__' + data.baglantiId + '__' + data.odevId
        && data.ogrenciUid == request.auth.uid
        && exists(linkPath)
        && link.ogrenciUid == request.auth.uid
        && link.durum == 'active'
        && link.izinler.odevler == true
        && exists(homeworkPath)
        && homework.uid == link.ogretmenUid
        && homework.sinifId == link.sinifId
        && homework.donemYili == link.donemYili
        && homework.hedefOgrenciIds.hasAny([link.ogrenciKayitId])
        && data.ogretmenUid == link.ogretmenUid
        && data.ogrenciKayitId == link.ogrenciKayitId
        && data.sinifId == link.sinifId
        && data.donemYili == link.donemYili
        && data.odevId is string
        && data.durum == 'tamamlandi_bildirildi';
    }

    function teacherCanCreateHomeworkNotice(data, notificationId) {
      let linkPath = studentLinkDocPath(data.baglantiId);
      let link = get(linkPath).data;
      let homeworkPath = /databases/$(database)/documents/odevler/$(data.odevId);
      let homework = get(homeworkPath).data;
      return isTeacher()
        && notificationId == data.odevId + '__' + data.ogrenciUid + '__' + data.baglantiId
        && data.ogretmenUid == request.auth.uid
        && data.uid == request.auth.uid
        && exists(linkPath)
        && link.ogretmenUid == request.auth.uid
        && link.ogrenciUid == data.ogrenciUid
        && link.ogrenciKayitId == data.ogrenciKayitId
        && link.sinifId == data.sinifId
        && link.durum == 'active'
        && link.izinler.odevler == true
        && exists(homeworkPath)
        && homework.uid == request.auth.uid
        && homework.sinifId == data.sinifId
        && homework.donemYili == data.donemYili
        && homework.hedefOgrenciIds.hasAny([data.ogrenciKayitId]);
    }


    match /kullanicilar/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isApplicationOwner());
      allow list: if isApplicationOwner();

      // Teacher profiles are self-created on Spark. Student profiles require a verified invite request.
      allow create: if createsOwnUserProfile(userId);

      // Kullanıcı rolünü, e-posta adresini veya uygulama sahibi claim alanlarını değiştiremez.
      allow update: if updatesOwnUserProfile(userId);

      allow delete: if false;
    }

    // Öğretmene ait okul kayıtları
    match /okullar/{docId} {
      allow read: if ownsRecord();
      allow create: if createsOwnPeriodRecord();
      allow update: if ownsEditablePeriodRecord() && keepsOwner() && keepsPeriod();
      allow delete: if ownsEditablePeriodRecord();
    }

    // Sınıf, yalnızca aynı öğretmene ait bir okula bağlanabilir.
    match /siniflar/{docId} {
      allow read: if ownsRecord() || studentHasPermission(resource.data.uid, docId, 'dersProgrami');
      allow create: if createsOwnPeriodRecord() && schoolBelongsToTeacher(request.resource.data);
      allow update: if ownsEditablePeriodRecord() && keepsOwner() && keepsPeriod() && schoolBelongsToTeacher(request.resource.data);
      allow delete: if ownsEditablePeriodRecord();
    }

    // Ders programı
    match /dersler/{docId} {
      allow read: if ownsRecord() || studentHasPermission(resource.data.uid, resource.data.sinifId, 'dersProgrami') || (isApplicationOwner() && isRetentionCleanupWindow(resource.data.donemYili));
      allow create: if createsOwnPeriodRecord() && classBelongsToTeacher(request.resource.data);
      allow update: if ownsEditablePeriodRecord() && keepsOwner() && keepsPeriod() && classBelongsToTeacher(request.resource.data);
      allow delete: if ownsEditablePeriodRecord();
    }

    // Öğrenci kayıtları (öğretmenin kendi öğrenci listesi)
    match /ogrenciler/{docId} {
      allow read: if ownsRecord() || (isStudent() && studentHasPermission(resource.data.uid, resource.data.sinifId, 'dersProgrami') && linkedStudentRecordId(resource.data.uid, resource.data.sinifId) == docId);
      allow create: if createsOwnPeriodRecord() && classBelongsToTeacher(request.resource.data);
      allow update: if ownsEditablePeriodRecord() && keepsOwner() && keepsPeriod() && classBelongsToTeacher(request.resource.data);
      allow delete: if ownsEditablePeriodRecord();
    }

    match /dersNotlari/{docId} {
      allow read: if ownsRecord() || studentHasPermission(resource.data.uid, resource.data.sinifId, 'dersNotlari') || (isApplicationOwner() && isRetentionCleanupWindow(resource.data.donemYili));
      allow create: if createsOwnPeriodRecord() && classBelongsToTeacher(request.resource.data) && optionalLessonBelongsToTeacher(request.resource.data);
      allow update: if ownsEditablePeriodRecord() && keepsOwner() && keepsPeriod() && classBelongsToTeacher(request.resource.data) && optionalLessonBelongsToTeacher(request.resource.data);
      allow delete: if ownsEditablePeriodRecord() || (isApplicationOwner() && isRetentionCleanupWindow(resource.data.donemYili));
    }

    match /yoklamalar/{docId} {
      allow read: if ownsRecord() || (studentHasPermission(resource.data.uid, resource.data.sinifId, 'yoklama') && resource.data.ogrenciId == linkedStudentRecordId(resource.data.uid, resource.data.sinifId)) || (isApplicationOwner() && isRetentionCleanupWindow(resource.data.donemYili));
      allow create: if createsOwnPeriodRecord() && classBelongsToTeacher(request.resource.data) && studentBelongsToClass(request.resource.data) && optionalLessonBelongsToTeacher(request.resource.data);
      allow update: if ownsEditablePeriodRecord() && keepsOwner() && keepsPeriod() && classBelongsToTeacher(request.resource.data) && studentBelongsToClass(request.resource.data) && optionalLessonBelongsToTeacher(request.resource.data);
      allow delete: if ownsEditablePeriodRecord() || (isApplicationOwner() && isRetentionCleanupWindow(resource.data.donemYili));
    }

    match /odevler/{docId} {
      allow read: if ownsRecord() || (studentHasPermission(resource.data.uid, resource.data.sinifId, 'odevler') && resource.data.hedefOgrenciIds.hasAny([linkedStudentRecordId(resource.data.uid, resource.data.sinifId)])) || (isApplicationOwner() && isRetentionCleanupWindow(resource.data.donemYili));
      allow create: if createsOwnPeriodRecord() && classBelongsToTeacher(request.resource.data) && optionalLessonBelongsToTeacher(request.resource.data);
      allow update: if ownsEditablePeriodRecord() && keepsOwner() && keepsPeriod() && classBelongsToTeacher(request.resource.data) && optionalLessonBelongsToTeacher(request.resource.data);
      allow delete: if ownsEditablePeriodRecord() || (isApplicationOwner() && isRetentionCleanupWindow(resource.data.donemYili));
    }

    match /kitaplar/{docId} {
      allow read: if ownsRecord() || (studentHasPermission(resource.data.uid, resource.data.sinifId, 'kitaplar') && resource.data.ogrenciId == linkedStudentRecordId(resource.data.uid, resource.data.sinifId)) || (isApplicationOwner() && isRetentionCleanupWindow(resource.data.donemYili));
      allow create: if createsOwnPeriodRecord() && studentBelongsToClass(request.resource.data);
      allow update: if ownsEditablePeriodRecord() && keepsOwner() && keepsPeriod() && studentBelongsToClassOrPendingTransfer(request.resource.data);
      allow delete: if ownsEditablePeriodRecord() || (isApplicationOwner() && isRetentionCleanupWindow(resource.data.donemYili));
    }

    match /konular/{docId} {
      allow read: if ownsRecord() || (studentHasPermission(resource.data.uid, resource.data.sinifId, 'konular') && resource.data.ogrenciId == linkedStudentRecordId(resource.data.uid, resource.data.sinifId)) || (isApplicationOwner() && isRetentionCleanupWindow(resource.data.donemYili));
      allow create: if createsOwnPeriodRecord() && studentBelongsToClass(request.resource.data) && assignedBookBelongsToStudent(request.resource.data);
      allow update: if ownsEditablePeriodRecord() && keepsOwner() && keepsPeriod() && studentBelongsToClassOrPendingTransfer(request.resource.data) && assignedBookBelongsToStudent(request.resource.data);
      allow delete: if ownsEditablePeriodRecord() || (isApplicationOwner() && isRetentionCleanupWindow(resource.data.donemYili));
    }

    // Kitap ve konu tanımları öğretmenin sezon bağımsız kütüphanesinde tutulur.
    // Öğrenciye atanan kopyalar kitaplar/konular koleksiyonlarında bağımsız ilerler.
    match /kitapKutuphanesi/{docId} {
      allow read: if ownsRecord();
      allow create: if createsOwnRecord() && validLibraryBook(request.resource.data);
      allow update: if ownsRecord()
        && keepsOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ad', 'sayfaSayisi'])
        && validLibraryBook(request.resource.data);
      allow delete: if ownsRecord();
    }

    match /kitapKutuphanesiKonulari/{docId} {
      allow read: if ownsRecord();
      allow create: if createsOwnRecord() && validLibraryTopic(request.resource.data);
      allow update: if ownsRecord()
        && keepsOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ad', 'baslangicSayfa', 'bitisSayfa', 'kazanımKodu', 'kaynak', 'kitapAd'])
        && validLibraryTopic(request.resource.data);
      allow delete: if ownsRecord();
    }


    // Takvimdeki bireysel ders / etüt / soru çözümü kayıtları öğretmen sahibine aittir.
    match /bireyselEtkinlikler/{docId} {
      allow read: if ownsRecord() || (studentHasPermission(resource.data.uid, resource.data.sinifId, 'dersProgrami') && resource.data.ogrenciId == linkedStudentRecordId(resource.data.uid, resource.data.sinifId));
      allow create: if createsOwnPeriodRecord() && studentBelongsToClass(request.resource.data);
      allow update: if ownsEditablePeriodRecord() && keepsOwner() && keepsPeriod() && studentBelongsToClass(request.resource.data);
      allow delete: if ownsEditablePeriodRecord();
    }

    match /bireyselDersOturumlari/{docId} {
      allow read: if ownsRecord() || (studentHasPermission(resource.data.uid, resource.data.sinifId, 'dersProgrami') && resource.data.ogrenciId == linkedStudentRecordId(resource.data.uid, resource.data.sinifId));
      allow create: if createsOwnPeriodRecord() && studentBelongsToClass(request.resource.data) && individualEventBelongsToTeacher(request.resource.data);
      allow update: if ownsEditablePeriodRecord() && keepsOwner() && keepsPeriod() && studentBelongsToClass(request.resource.data) && individualEventBelongsToTeacher(request.resource.data);
      allow delete: if ownsEditablePeriodRecord();
    }

    match /ogrenciEslesmeKodlari/{codeId} {
      allow get: if signedIn()
        && (resource.data.ogretmenUid == request.auth.uid
          || (request.auth.token.email_verified == true
            && resource.data.eposta == request.auth.token.email
            && resource.data.kullanildi == false
            && resource.data.sonaErme > request.time));
      allow list: if false;
      allow create: if createsPairingCode(codeId);
      allow update: if consumesPairingCode(codeId);
      allow delete: if false;
    }

    match /ogretmenOgrenciBaglantilari/{linkId} {
      allow get, list: if signedIn()
        && (isApplicationOwner()
          || resource.data.ogretmenUid == request.auth.uid
          || resource.data.ogrenciUid == request.auth.uid);
      allow create: if createsApprovedStudentLink(linkId);
      allow update: if isTeacher()
        && resource.data.ogretmenUid == request.auth.uid
        && (
          (resource.data.durum == 'active'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['izinler', 'izinGuncelleme'])
            && validStudentPermissions(request.resource.data.izinler))
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum', 'iptalTarihi'])
            && request.resource.data.durum == 'revoked')
          || reactivatesStudentLink(linkId)
        );
      allow delete: if false;
    }

    match /ogrenciKayitEslesmeleri/{indexId} {
      allow get, list: if isTeacher() && resource.data.ogretmenUid == request.auth.uid;
      allow create: if createsApprovedStudentIndex(indexId);
      allow update: if (
        isTeacher()
        && resource.data.ogretmenUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum', 'iptalTarihi'])
        && request.resource.data.durum == 'revoked'
      ) || reactivatesStudentIndex(indexId);
      allow delete: if false;
    }

    match /ogrenciEslesmeTalepleri/{requestId} {
      allow get, list: if signedIn()
        && (isApplicationOwner()
          || resource.data.ogretmenUid == request.auth.uid
          || resource.data.ogrenciUid == request.auth.uid);
      allow create: if validStudentPairingRequest(request.resource.data);
      allow update: if updatesPairingRequest(requestId);
      allow delete: if false;
    }

    match /ogrenciOdevBildirimleri/{notificationId} {
      allow get, list: if signedIn()
        && (resource.data.ogretmenUid == request.auth.uid
          || resource.data.ogrenciUid == request.auth.uid);
      allow create: if studentCanCreateHomeworkCompletion(request.resource.data, notificationId);
      allow update, delete: if false;
    }

    match /ogrenciYeniOdevBildirimleri/{notificationId} {
      allow get, list: if signedIn()
        && (resource.data.ogrenciUid == request.auth.uid
          || resource.data.ogretmenUid == request.auth.uid);
      allow create: if teacherCanCreateHomeworkNotice(request.resource.data, notificationId);
      allow update: if (
        isStudent()
        && resource.data.ogrenciUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['okundu', 'okunduTarihi'])
        && request.resource.data.okundu == true
        && request.resource.data.okunduTarihi == request.time
      ) || (
        isTeacher()
        && resource.data.ogretmenUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum', 'iptalTarihi'])
        && request.resource.data.durum == 'iptal'
      );
      allow delete: if false;
    }

    // Push belirteçleri kişisel cihaz bilgisi sayılır; yalnızca Admin SDK erişebilir.
    match /ogrenciPushTokenlari/{tokenId} {
      allow read, write: if false;
    }

    match /donemTemizlikKayitlari/{cleanupId} {
      allow get, list: if isApplicationOwner();
      // Kilit ve denetim kaydı yalnızca Admin SDK kullanan güvenli callable tarafından yazılır.
      allow create, update, delete: if false;
    }

    // Tanımlanmamış koleksiyonlar ve yollar varsayılan olarak kapalıdır.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
